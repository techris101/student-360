# Copy to .env.local and fill in. Never commit .env.local.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings > API, and > Database)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=          # "anon" or "publishable" key
SUPABASE_SERVICE_ROLE_KEY=              # "service_role" or "secret" key. Server only.
SUPABASE_PROJECT_REF=                   # the id in your project URL
SUPABASE_DB_PASSWORD=                   # set when you created the project
SUPABASE_ACCESS_TOKEN=                  # Account > Access Tokens (lets the agent run migrations)

# Google AI Studio (aistudio.google.com > Get API key)
GOOGLE_GENERATIVE_AI_API_KEY=
AI_MODEL_FAST=gemini-2.5-flash-lite     # agent fills: cheapest current Flash-Lite-class model
AI_MODEL_SMART=gemini-2.5-flash        # agent fills: current Flash-class model
AI_DAILY_MESSAGE_CAP=30

# Vercel (Account Settings > Tokens)
VERCEL_TOKEN=

# Admin access (your login email)
ADMIN_EMAILS=techris101@gmail.com

# Random long string, agent can generate
CRON_SECRET=

# Optional: email reminders (resend.com). Leave empty to disable email.
RESEND_API_KEY=
EMAIL_FROM=
